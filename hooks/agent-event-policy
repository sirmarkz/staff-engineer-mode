#!/usr/bin/env bash
# Agent-side event policy hook for Staff Engineer Mode.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
RECEIPT_DIR="staff-engineer-mode/agent-event-receipts"

json_escape() {
  if command -v python3 >/dev/null 2>&1; then
    VALUE="$1" python3 - <<'PY'
import json
import os

print(json.dumps(os.environ["VALUE"]))
PY
    return
  fi

  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '"%s"\n' "$value"
}

shell_quote() {
  printf '%q' "$1"
}

block_tool() {
  local reason="$1"
  printf '%s\n' "$reason" >&2
  printf '{\n  "decision": "block",\n  "reason": %s\n}\n' "$(json_escape "$reason")"
  exit 2
}

hash_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{ print $1 }'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 | awk '{ print $NF }'
  else
    printf 'staff-engineer-mode: sha256 tool not found\n' >&2
    exit 1
  fi
}

extract_command() {
  local hook_input="$1"

  if command -v python3 >/dev/null 2>&1; then
    HOOK_INPUT="$hook_input" python3 - <<'PY'
import json
import os

try:
    value = json.loads(os.environ["HOOK_INPUT"] or "{}")
except json.JSONDecodeError:
    value = {}

for path in (
    ("tool_input", "command"),
    ("tool_input", "cmd"),
    ("input", "command"),
    ("command",),
):
    current = value
    for key in path:
        if not isinstance(current, dict):
            current = None
            break
        current = current.get(key)
    if isinstance(current, str):
        print(current)
        break
PY
    return
  fi

  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$hook_input" | jq -r '(.tool_input.command // .tool_input.cmd // .input.command // .command // "")'
  fi
}

command_has_ai_commit_attribution() {
  local command_text="$1"
  local attribution_marker='(co-authored-by|generated-by|assisted-by|written-by|created-by):'
  local ai_identity='(noreply@anthropic[.]com|noreply@openai[.]com|anthropic|openai|codex|chatgpt|copilot|gemini|ai[ -]?assistant|claude[[:space:]_-]+(sonnet|opus|code))'
  printf '%s\n' "$command_text" | grep -Eiq "${attribution_marker}.*${ai_identity}"
}

classify_command() {
  local command_text="$1"
  local gh_selector_flag='(--repo([[:space:]]+|=)[^[:space:]]+|-R([[:space:]]+|=)?[^[:space:]]+|--hostname([[:space:]]+|=)[^[:space:]]+)'
  local gh_env_selector='(^|[[:space:];|&])([A-Z_][A-Z0-9_]*=[^[:space:];|&]+[[:space:]]+)*(GH_REPO|GH_HOST)=[^[:space:];|&]+([[:space:]]+[A-Z_][A-Z0-9_]*=[^[:space:];|&]+)*[[:space:]]+gh[[:space:]]'
  local gh_action='(create|edit|upload|delete|delete-asset)'
  local gh_mutating_release="(^|[[:space:];|&])gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)*release[[:space:]]+(${gh_selector_flag}[[:space:]]+)*${gh_action}([[:space:]]|$)"
  local gh_remote_selector_before_release="(^|[[:space:];|&])gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)+release[[:space:]]+(${gh_selector_flag}[[:space:]]+)*${gh_action}([[:space:]]|[;|&]|$)"
  local gh_remote_selector_before_action="(^|[[:space:];|&])gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)*release[[:space:]]+(${gh_selector_flag}[[:space:]]+)+${gh_action}([[:space:]]|[;|&]|$)"
  local gh_remote_selector_after_action="(^|[[:space:];|&])gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)*release[[:space:]]+(${gh_selector_flag}[[:space:]]+)*${gh_action}([[:space:]][^;|&]*)?${gh_selector_flag}([[:space:]]|[;|&]|$)"
  local gh_remote_mutating_release="${gh_remote_selector_before_release}|${gh_remote_selector_before_action}|${gh_remote_selector_after_action}"
  local gh_inherited_selector=false
  if [ -n "${GH_REPO:-}" ] || [ -n "${GH_HOST:-}" ]; then
    gh_inherited_selector=true
  fi

  if command -v python3 >/dev/null 2>&1; then
    COMMAND_TEXT="$command_text" python3 - <<'PY'
import os
import os.path
import re
import shlex

command = os.environ["COMMAND_TEXT"]
try:
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    tokens = list(lexer)
except ValueError:
    tokens = command.split()

if not tokens:
    raise SystemExit

def emit(event, cwd="."):
    print(f"{event}\t{cwd}")
    raise SystemExit

def is_version_tag(value):
    return bool(re.match(r"^v?\d+(?:\.\d+){1,3}(?:[-+][A-Za-z0-9_.-]+)?$", value))

env_assignment = re.compile(r"^([A-Z_][A-Z0-9_]*)=")
mutating_gh_release_actions = {"create", "edit", "upload", "delete", "delete-asset"}
shell_separators = {";", "&&", "||", "|", "|&", "&"}
selector_names = {"GH_REPO", "GH_HOST"}

def assignment_parts(token):
    match = env_assignment.match(token)
    if match:
        return match.group(1), token[match.end():]
    return None, None

def gh_command_has_selector(index):
    active_selectors = {name for name in selector_names if os.environ.get(name)}
    start = index
    while start > 0 and tokens[start - 1] not in shell_separators:
        start -= 1
    cursor = start
    while cursor < index:
        name, value = assignment_parts(tokens[cursor])
        if name is None:
            break
        if name in selector_names:
            if value:
                active_selectors.add(name)
            else:
                active_selectors.discard(name)
        cursor += 1
    return bool(active_selectors)

def gh_release_event(index):
    cursor = index + 1
    has_repo_flag = gh_command_has_selector(index)
    # Step 1: skip leading global flags to find the gh subcommand.
    while cursor < len(tokens):
        arg = tokens[cursor]
        if arg in shell_separators:
            return None
        if arg in {"--repo", "-R"} and cursor + 1 < len(tokens):
            has_repo_flag = True
            cursor += 2
            continue
        if arg.startswith("--repo=") or arg.startswith("-R="):
            has_repo_flag = True
            cursor += 1
            continue
        if arg.startswith("-R") and len(arg) > 2:
            has_repo_flag = True
            cursor += 1
            continue
        if arg == "--hostname" and cursor + 1 < len(tokens):
            has_repo_flag = True
            cursor += 2
            continue
        if arg.startswith("--hostname="):
            has_repo_flag = True
            cursor += 1
            continue
        if arg.startswith("-"):
            cursor += 1
            continue
        break
    # Step 2: subcommand must be exactly "release"; the first positional
    # after release-subcommand args is the action. Track repo and host
    # selectors in any inherited position.
    if cursor >= len(tokens) or tokens[cursor] != "release":
        return None
    sub_idx = cursor + 1
    action = None
    while sub_idx < len(tokens):
        arg = tokens[sub_idx]
        if arg in shell_separators:
            break
        if arg in {"--repo", "-R"} and sub_idx + 1 < len(tokens):
            has_repo_flag = True
            sub_idx += 2
            continue
        if arg.startswith("--repo=") or arg.startswith("-R="):
            has_repo_flag = True
            sub_idx += 1
            continue
        if arg.startswith("-R") and len(arg) > 2:
            has_repo_flag = True
            sub_idx += 1
            continue
        if arg == "--hostname" and sub_idx + 1 < len(tokens):
            has_repo_flag = True
            sub_idx += 2
            continue
        if arg.startswith("--hostname="):
            has_repo_flag = True
            sub_idx += 1
            continue
        if arg.startswith("-"):
            sub_idx += 1
            continue
        if action is None:
            action = arg
        sub_idx += 1
    if action not in mutating_gh_release_actions:
        return None
    if has_repo_flag:
        return "release_remote"
    return "release"

for index, token in enumerate(tokens):
    if token == "gh" and gh_release_event(index) == "release_remote":
        emit("release_remote")

shell_cwd = "."
staged_repos = set()
# Subshell-scoped `cd` is intentionally treated as outer-scope: over-blocking
# is the safe direction when shell scope is ambiguous from tokens alone.
for index, token in enumerate(tokens):
    if token == "cd" and index + 1 < len(tokens):
        next_cd = tokens[index + 1]
        if os.path.isabs(next_cd):
            shell_cwd = next_cd
        else:
            shell_cwd = os.path.normpath(os.path.join(shell_cwd, next_cd))
        continue

    if token == "git":
        cursor = index + 1
        cwd = shell_cwd
        while cursor < len(tokens):
            current = tokens[cursor]
            if current == "-C" and cursor + 1 < len(tokens):
                cwd = tokens[cursor + 1]
                cursor += 2
                continue
            if current.startswith("-C") and len(current) > 2:
                cwd = current[2:]
                cursor += 1
                continue
            if current in {"-c", "--git-dir", "--work-tree", "--namespace"} and cursor + 1 < len(tokens):
                cursor += 2
                continue
            if current.startswith("-"):
                cursor += 1
                continue
            break
        if cursor >= len(tokens):
            continue

        subcommand = tokens[cursor]
        rest = tokens[cursor + 1:]
        if subcommand == "add":
            staged_repos.add(cwd)
        if subcommand == "commit":
            if cwd in staged_repos:
                emit("stage_and_commit", cwd)
            for arg in rest:
                if arg == "-a" or (arg.startswith("-") and not arg.startswith("--") and "a" in arg[1:]):
                    emit("commit_all", cwd)
            emit("commit", cwd)
        if subcommand == "tag":
            creates_tag = any(not arg.startswith("-") and is_version_tag(arg) for arg in rest)
            annotated_tag = any(arg in {"-a", "-s", "-u"} for arg in rest)
            if creates_tag or annotated_tag:
                emit("release", cwd)
        if subcommand == "push":
            if "--tags" in rest or any(is_version_tag(arg) for arg in rest):
                emit("release", cwd)

    if token == "gh":
        event = gh_release_event(index)
        if event == "release_remote":
            emit("release_remote", shell_cwd)
        if event == "release":
            emit("release", shell_cwd)

    if token.endswith("bump-version.sh"):
        emit("release", shell_cwd)
PY
    return
  fi

  if printf '%s\n' "$command_text" | grep -Eq "$gh_mutating_release" \
    && { [ "$gh_inherited_selector" = true ] \
      || printf '%s\n' "$command_text" | grep -Eq "${gh_env_selector}|${gh_remote_mutating_release}"; }; then
    printf 'release_remote\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq '(^|[[:space:];|&])git[[:space:]].*add([[:space:]]|$).*(^|[[:space:];|&])git[[:space:]].*commit([[:space:]]|$)'; then
    printf 'stage_and_commit\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq '(^|[[:space:];|&])git[[:space:]].*commit([[:space:]]|$)'; then
    printf 'commit\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq '(^|[[:space:];|&])git[[:space:]].*(tag|push)([[:space:]]|$)'; then
    printf 'release\t.\n'
  # gh release detection (degraded path, python3 unavailable): require release
  # to be the gh subcommand, optionally preceded by recognized global flags so
  # commands like `gh issue create --title release` are not classified as
  # releases.
  elif printf '%s\n' "$command_text" | grep -Eq "$gh_mutating_release"; then
    printf 'release\t.\n'
  fi
}

repo_root() {
  local repo_hint="$1"
  if git -C "$repo_hint" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$repo_hint" rev-parse --show-toplevel
  else
    return 1
  fi
}

git_dir() {
  local repo="$1"
  local dir
  dir="$(git -C "$repo" rev-parse --git-dir)"
  case "$dir" in
    /*) printf '%s\n' "$dir" ;;
    *) printf '%s/%s\n' "$repo" "$dir" ;;
  esac
}

commit_key() {
  local repo="$1"
  git -C "$repo" diff --cached --binary | hash_stdin
}

release_key() {
  local repo="$1"
  {
    git -C "$repo" rev-parse HEAD 2>/dev/null || printf 'no-head\n'
    git -C "$repo" diff --cached --binary
  } | hash_stdin
}

receipt_path() {
  local repo="$1"
  local event="$2"
  local key="$3"
  printf '%s/%s/%s/%s.json\n' "$(git_dir "$repo")" "$RECEIPT_DIR" "$event" "$key"
}

write_receipt() {
  local event="$1"
  local repo="$2"
  local key="$3"
  local override="${4:-false}"
  local rationale="${5:-}"
  local receipt
  receipt="$(receipt_path "$repo" "$event" "$key")"
  mkdir -p "$(dirname "$receipt")"
  printf '{\n  "event": "%s",\n  "key": "%s",\n  "head": "%s",\n  "created_at": "%s",\n  "override": %s,\n  "rationale": %s\n}\n' \
    "$event" \
    "$key" \
    "$(git -C "$repo" rev-parse HEAD 2>/dev/null || printf 'no-head')" \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    "$override" \
    "$(json_escape "$rationale")" > "$receipt"
  printf 'recorded staff-engineer-mode %s receipt for %s\n' "$event" "$key"
}

has_receipt() {
  local repo="$1"
  local event="$2"
  local key="$3"
  test -f "$(receipt_path "$repo" "$event" "$key")"
}

parent_command_text() {
  local parent_pid="${PPID:-}"
  if [ -n "$parent_pid" ] && [ -r "/proc/${parent_pid}/cmdline" ]; then
    tr '\0' ' ' < "/proc/${parent_pid}/cmdline"
    return
  fi

  if [ -n "$parent_pid" ] && command -v ps >/dev/null 2>&1; then
    ps -o command= -p "$parent_pid" 2>/dev/null || true
  fi
}

command_mentions_ack_event() {
  local command_text="$1"
  local event="$2"
  printf '%s\n' "$command_text" | grep -Eq "(^|[[:space:];|&])ack[[:space:]]+${event}([[:space:]]|$)"
}

assert_ack_is_standalone() {
  local event="$1"
  local command_text classification protected_event
  command_text="$(parent_command_text)"
  [ -n "$command_text" ] || return 0
  command_mentions_ack_event "$command_text" "$event" || return 0

  classification="$(classify_command "$command_text")"
  [ -n "$classification" ] || return 0
  protected_event="${classification%%	*}"

  case "$event:$protected_event" in
    commit:commit|commit:commit_all|commit:stage_and_commit)
      printf 'Staff Engineer Mode ack commit must run as its own shell command. Do not combine the ack command with the commit command; run the receipt command first, then retry the commit in a separate shell command.\n' >&2
      exit 2
      ;;
    release:release|release:release_remote)
      printf 'Staff Engineer Mode ack release must run as its own shell command. Do not combine the ack command with the release command; run the receipt command first, then retry the release, tag, push, or promotion command in a separate shell command.\n' >&2
      exit 2
      ;;
  esac
}

ack_event() {
  local event="${1:-}"
  shift || true
  local override="false"
  local rationale=""
  local repo_hint="."
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo)
        shift
        repo_hint="${1:-}"
        if [ -z "$repo_hint" ]; then
          printf 'usage: %s ack commit|release [--repo path] [--override rationale]\n' "$0" >&2
          exit 1
        fi
        shift
        ;;
      --repo=*)
        repo_hint="${1#--repo=}"
        shift
        ;;
      --override)
        override="true"
        shift
        rationale="${*:-user accepted unresolved review findings}"
        break
        ;;
      --override=*)
        override="true"
        rationale="${1#--override=}"
        shift
        ;;
      *)
        printf 'usage: %s ack commit|release [--repo path] [--override rationale]\n' "$0" >&2
        exit 1
        ;;
    esac
  done

  local repo
  repo="$(repo_root "$repo_hint")" || {
    printf 'staff-engineer-mode: --repo must be a local checkout root from git rev-parse --show-toplevel, not a remote URL or bare repository\n' >&2
    exit 1
  }

  case "$event" in
    commit)
      assert_ack_is_standalone "commit"
      write_receipt "commit" "$repo" "$(commit_key "$repo")" "$override" "$rationale"
      ;;
    release)
      assert_ack_is_standalone "release"
      write_receipt "release" "$repo" "$(release_key "$repo")" "$override" "$rationale"
      ;;
    *)
      printf 'usage: %s ack commit|release [--repo path] [--override rationale]\n' "$0" >&2
      exit 1
      ;;
  esac
}

pretooluse() {
  local hook_input command_text classification event repo_hint repo
  hook_input="$(cat || true)"
  command_text="$(extract_command "$hook_input")"
  [ -n "$command_text" ] || exit 0

  classification="$(classify_command "$command_text")"
  [ -n "$classification" ] || exit 0

  event="${classification%%	*}"
  repo_hint="${classification#*	}"
  [ "$repo_hint" != "$classification" ] || repo_hint="."

  # Cross-repo gh releases are blocked regardless of local checkout state;
  # handle before requiring a local repo so non-repo directories cannot bypass.
  if [ "$event" = "release_remote" ]; then
    block_tool "Staff Engineer Mode before_release policy: gh --repo / -R / --hostname / GH_REPO / GH_HOST targets a remote repository or host, not just the local checkout. A local release receipt cannot authorize a cross-repo release. To proceed, remove the remote repo or host selector and run gh release from the target repository's checkout (so the local release-build-reproducibility and production-readiness-review checks plus release receipt apply), or temporarily disable this hook with explicit user authorization."
  fi

  repo="$(repo_root "$repo_hint")" || repo="$(repo_root ".")" || exit 0
  local quoted_repo
  quoted_repo="$(shell_quote "$repo")"
  local has_ai_attribution=false
  local attribution_instruction=""
  if command_has_ai_commit_attribution "$command_text"; then
    has_ai_attribution=true
    attribution_instruction=" Remove any AI assistant Co-Authored-By or attribution trailer before retrying the commit command."
  fi

  case "$event" in
    stage_and_commit)
      block_tool "Staff Engineer Mode before_commit policy blocked a command that stages and commits in the same shell command. The staging command in that same shell command has not run yet, so the staged diff may be empty. Run the staging command separately; read ${PLUGIN_ROOT}/specialists/agent-pr-review.md; review git diff --cached for ${repo}; run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} as its own shell command; then retry only the commit command in a separate shell command. Do not combine staging, ack, commit, or push in one shell command.${attribution_instruction} If the user explicitly accepts unresolved gaps after review, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} --override \"<rationale>\" as its own shell command."
      ;;
    commit_all)
      block_tool "Staff Engineer Mode before_commit policy requires review of the exact staged diff. Stage intended changes first, run agent-pr-review on that staged diff, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} as its own shell command, then retry the commit without commit -a in a separate shell command."
      ;;
    commit)
      if [ "$has_ai_attribution" = true ]; then
        block_tool "Staff Engineer Mode before_commit policy blocks AI assistant co-author or attribution trailers in commit messages. Remove the AI co-author or attribution, then retry through the normal agent-pr-review and ack commit flow for ${repo}."
      fi
      local key
      key="$(commit_key "$repo")"
      if ! has_receipt "$repo" "commit" "$key"; then
        block_tool "Staff Engineer Mode before_commit policy requires agent-pr-review before creating or amending a commit. Read ${PLUGIN_ROOT}/specialists/agent-pr-review.md and review the staged diff for ${repo}; inspecting git diff --cached or reading CLAUDE.md / SKILL.md alone is not enough. If the review is clean, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} as its own shell command. Do not combine the ack command with the commit command; the PreToolUse hook checks the whole shell command before either subcommand can run. If the user explicitly accepts unresolved gaps after they are shown, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} --override \"<rationale>\" as its own shell command. Then retry the commit in a separate shell command."
      fi
      ;;
    release)
      local key
      key="$(release_key "$repo")"
      if ! has_receipt "$repo" "release" "$key"; then
        block_tool "Staff Engineer Mode before_release policy requires release-build-reproducibility and production-readiness-review before release, tag, version, package, artifact, or promotion commands. Read ${PLUGIN_ROOT}/specialists/release-build-reproducibility.md and check pinned inputs, artifact identity, promotion, and rollback traceability for ${repo}. Read ${PLUGIN_ROOT}/specialists/production-readiness-review.md and check release ownership, rollback, watch, and operator impact for ${repo}; reading CLAUDE.md / SKILL.md alone is not enough. If both reviews are clean, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack release --repo ${quoted_repo} as its own shell command. Do not combine the ack command with the release command; the PreToolUse hook checks the whole shell command before either subcommand can run. If the user explicitly accepts unresolved gaps after they are shown, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack release --repo ${quoted_repo} --override \"<rationale>\" as its own shell command. Then retry the release command in a separate shell command. For tags, create the tag and push the tag in separate shell commands."
      fi
      ;;
  esac
}

case "${1:-pretooluse}" in
  pretooluse) pretooluse ;;
  ack)
    shift
    ack_event "$@"
    ;;
  *)
    printf 'usage: %s pretooluse|ack commit|ack release\n' "$0" >&2
    exit 1
    ;;
esac
