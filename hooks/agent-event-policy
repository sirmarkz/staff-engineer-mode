#!/usr/bin/env bash
# Agent-side event policy hook for Staff Engineer Mode.

set -euo pipefail

case "$0" in
  */*) script_dir_arg="${0%/*}" ;;
  *) script_dir_arg="." ;;
esac
SCRIPT_DIR="$((cd "$script_dir_arg" 2>/dev/null && pwd) || printf '%s\n' "$script_dir_arg")"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
RECEIPT_DIR="staff-engineer-mode/agent-event-receipts"

json_escape() {
  if command -v python3 >/dev/null 2>&1; then
    VALUE="$1" python3 - <<'PY'
import json
import os

print(json.dumps(os.environ["VALUE"]))
PY
    return
  fi

  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '"%s"\n' "$value"
}

shell_quote() {
  printf '%q' "$1"
}

record_probe_block() {
  local reason="$1"
  [ -n "${SEM_HOOK_PROBE_MARKER:-}" ] || return 0
  local marker_dir escaped_command escaped_reason
  marker_dir="$(dirname "$SEM_HOOK_PROBE_MARKER")" || return 0
  mkdir -p "$marker_dir" 2>/dev/null || return 0
  escaped_command="$(json_escape "${command_text:-}")"
  escaped_reason="$(json_escape "$reason")"
  printf '{"event":"pretooluse_block","command":%s,"reason":%s}\n' \
    "$escaped_command" \
    "$escaped_reason" >> "$SEM_HOOK_PROBE_MARKER" 2>/dev/null || true
}

block_tool() {
  local reason="$1"
  local display_reason escaped_reason
  display_reason="${reason} If this policy was triggered accidentally, stop, explain the blocked command, and ask the user to confirm the intended action before retrying."
  record_probe_block "$display_reason"
  escaped_reason="$(json_escape "$display_reason")"
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PreToolUse",\n    "permissionDecision": "deny",\n    "permissionDecisionReason": %s\n  },\n  "systemMessage": %s\n}\n' "$escaped_reason" "$escaped_reason"
  exit 0
}

hash_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{ print $1 }'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 | awk '{ print $NF }'
  elif command -v git >/dev/null 2>&1; then
    git hash-object --stdin
  elif command -v cksum >/dev/null 2>&1; then
    cksum | awk '{ print $1 "-" $2 }'
  else
    cat >/dev/null || true
    printf 'hash-unavailable\n'
  fi
}

extract_command() {
  local hook_input="$1"

  if command -v python3 >/dev/null 2>&1; then
    HOOK_INPUT="$hook_input" python3 - <<'PY'
import json
import os

try:
    value = json.loads(os.environ["HOOK_INPUT"] or "{}")
except json.JSONDecodeError:
    value = {}

for path in (
    ("tool_input", "command"),
    ("tool_input", "cmd"),
    ("input", "command"),
    ("command",),
):
    current = value
    for key in path:
        if not isinstance(current, dict):
            current = None
            break
        current = current.get(key)
    if isinstance(current, str):
        print(current)
        break
PY
    return
  fi

  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$hook_input" | jq -r '(.tool_input.command // .tool_input.cmd // .input.command // .command // "")'
    return
  fi

  if command -v awk >/dev/null 2>&1; then
    printf '%s' "$hook_input" | awk '
      {
        text = text $0 "\n"
      }
      END {
        if (!match(text, /"(command|cmd)"[[:space:]]*:[[:space:]]*"/)) {
          exit
        }
        start = RSTART + RLENGTH
        out = ""
        escaped = 0
        for (i = start; i <= length(text); i++) {
          char = substr(text, i, 1)
          if (escaped) {
            if (char == "n") {
              out = out "\n"
            } else if (char == "r") {
              out = out "\r"
            } else if (char == "t") {
              out = out "\t"
            } else {
              out = out char
            }
            escaped = 0
            continue
          }
          if (char == "\\") {
            escaped = 1
            continue
          }
          if (char == "\"") {
            print out
            exit
          }
          out = out char
        }
      }
    '
  fi
}

command_has_ai_commit_attribution() {
  local command_text="$1"
  local attribution_marker='(co-authored-by|generated-by|assisted-by|written-by|created-by):'
  local ai_identity='(noreply@anthropic[.]com|noreply@openai[.]com|anthropic|openai|codex|chatgpt|copilot|gemini|ai[ -]?assistant|claude[[:space:]_-]+(sonnet|opus|code))'
  printf '%s\n' "$command_text" | grep -Eiq "${attribution_marker}.*${ai_identity}"
}

command_stages_before_commit() {
  local command_text="$1"
  printf '%s\n' "$command_text" | grep -Eq '(^|[[:space:];|&])git[[:space:]][^;|&]*add([[:space:]]|$).*(^|[[:space:];|&])git[[:space:]][^;|&]*commit([[:space:]]|$)'
}

classify_command() {
  local command_text="$1"
  local command_start='(^[[:space:]]*|[;|&(){}][[:space:]]*)'
  local command_wrapper_prefix='(((if|then|elif|else|while|until|do|command|exec|nohup|!)[[:space:]]+)|(time([[:space:]]+-[^[:space:];|&()]+)*[[:space:]]+))*'
  local executable_path='([^[:space:];|&()]+/)?'
  local assignment_token='[A-Za-z_][A-Za-z0-9_]*=[^[:space:];|&()]+'
  local env_option='(-i|--ignore-environment|-u[[:space:]]+[A-Za-z_][A-Za-z0-9_]*|--unset[[:space:]]+[A-Za-z_][A-Za-z0-9_]*|--unset=[A-Za-z_][A-Za-z0-9_]*|--)'
  local env_prefix="(env[[:space:]]+((${env_option}|${assignment_token})[[:space:]]+)*)?"
  local executable_prefix="${command_start}${command_wrapper_prefix}(${assignment_token}[[:space:]]+)*${env_prefix}"
  local gh_selector_flag='(--repo([[:space:]]+|=)[^[:space:]]+|-R([[:space:]]+|=)?[^[:space:]]+|--hostname([[:space:]]+|=)[^[:space:]]+)'
  local gh_env_selector="${command_start}${command_wrapper_prefix}((env[[:space:]]+)?(${assignment_token}[[:space:]]+)*)(GH_REPO|GH_HOST)=[^[:space:];|&]+([[:space:]]+${assignment_token})*[[:space:]]+gh[[:space:]]"
  local gh_action='(create|edit|upload|delete|delete-asset)'
  local gh_mutating_release="${executable_prefix}${executable_path}gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)*release[[:space:]]+(${gh_selector_flag}[[:space:]]+)*${gh_action}([[:space:]]|$)"
  local gh_remote_selector_before_release="${executable_prefix}${executable_path}gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)+release[[:space:]]+(${gh_selector_flag}[[:space:]]+)*${gh_action}([[:space:]]|[;|&]|$)"
  local gh_remote_selector_before_action="${executable_prefix}${executable_path}gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)*release[[:space:]]+(${gh_selector_flag}[[:space:]]+)+${gh_action}([[:space:]]|[;|&]|$)"
  local gh_remote_selector_after_action="${executable_prefix}${executable_path}gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)*release[[:space:]]+(${gh_selector_flag}[[:space:]]+)*${gh_action}([[:space:]][^;|&]*)?${gh_selector_flag}([[:space:]]|[;|&]|$)"
  local gh_remote_mutating_release="${gh_remote_selector_before_release}|${gh_remote_selector_before_action}|${gh_remote_selector_after_action}"
  local version_tag_ref='v?[0-9]+([.][0-9]+){1,3}([-+][A-Za-z0-9_.-]+)?'
  local tag_name='[A-Za-z0-9][A-Za-z0-9_.-]*'
  local git_global_option='(-C([^[:space:];|&]+|[[:space:]]+[^[:space:];|&]+)|-c[[:space:]]+[^[:space:];|&]+|--git-dir([[:space:]]+|=)[^[:space:];|&]+|--work-tree([[:space:]]+|=)[^[:space:];|&]+|--namespace([[:space:]]+|=)[^[:space:];|&]+)'
  local git_unsafe_global_selector='(-c([[:space:]]+[^[:space:];|&]+|[^[:space:];|&]+)|--(bare|config-env|exec-path|git-dir|namespace|work-tree)([[:space:]]+|=)[^[:space:];|&]+|--bare)'
  local git_unsafe_env_selector='GIT_(ALTERNATE_OBJECT_DIRECTORIES|COMMON_DIR|CONFIG_(COUNT|PARAMETERS|KEY_[0-9]+|VALUE_[0-9]+)|DIR|INDEX_FILE|NAMESPACE|OBJECT_DIRECTORY|WORK_TREE)=[^[:space:];|&]+'
  local git_command_prefix="${executable_prefix}${executable_path}git[[:space:]]+(${git_global_option}[[:space:]]+)*"
  local git_add_command="${git_command_prefix}add([[:space:];|&]|$)"
  local git_commit_prefix="${git_command_prefix}commit"
  local git_commit_command="${git_commit_prefix}([[:space:];|&]|$)"
  local git_push_command="${git_command_prefix}push([[:space:];|&]|$)"
  local git_redirected_protected="${executable_prefix}git[[:space:]]+[^;|&]*-C([^[:space:];|&]+|[[:space:]]+[^[:space:];|&]+)[^;|&]*(commit|tag|push)([[:space:];|&]|$)"
  local git_commit_implicit="${git_commit_prefix}[[:space:]]+[^;|&]*(--(all|include|interactive|only|patch|pathspec-file-nul|pathspec-from-file)([=[:space:];|&]|$)|-[A-Za-z]*[aiop][A-Za-z]*)"
  local shell_arg='("[^"]*"|[^[:space:];|&]+)'
  local git_commit_pathspec="(${git_commit_prefix}[[:space:]]+[^-[:space:];|&]|${git_commit_prefix}[[:space:]]+[^;|&]*[[:space:]]--[[:space:]]+${shell_arg}|${git_commit_prefix}[[:space:]]+[^;|&]*(-m|--message)([=[:space:]]+)${shell_arg}[[:space:]]+[^-[:space:];|&][^[:space:];|&]*)"
  local git_tag_mutating_flag='(-[A-Za-z]*[asufdmF][A-Za-z]*|--(annotate|sign|local-user|force|delete|message|file|cleanup|edit)([=[:space:];|&]|$))'
  local git_tag_command="${git_command_prefix}tag[[:space:]]+(${git_tag_mutating_flag}|${tag_name})([[:space:];|&]|$)"
  local git_push_tag_command="${git_command_prefix}push[^;|&]*(--tags|--follow-tags|--mirror|refs/tags/|[[:space:]]tag[[:space:]]+${tag_name}|${version_tag_ref})([[:space:];|&]|$)"
  local release_script_name='(bump-version|version|package|release|publish|promote|publish-release|promote-artifact|cut-release)([.](sh|py|js|ts))?'
  local release_exec_prefix="${command_wrapper_prefix}(${assignment_token}[[:space:]]+)*${env_prefix}(${executable_path}(bash|sh|python([0-9]+([.][0-9]+)*)?|node)([[:space:]]+-[^[:space:];|&()]+)*[[:space:]]+)?(([.]/)|([.][.]/)+)?(scripts|tools|bin)/([.]/)*"
  local repo_release_script="${command_start}${release_exec_prefix}${release_script_name}([[:space:];|&()]|$)"
  local repo_release_read_only="^[[:space:]]*${release_exec_prefix}bump-version([.](sh|py|js|ts))?[[:space:]]+--(check|audit)[[:space:]]*$"
  local release_command_pattern="${git_tag_command}|${git_push_tag_command}|${repo_release_script}|${gh_mutating_release}"
  local bare_git_protected="${command_wrapper_prefix}(${assignment_token}[[:space:]]+)*${env_prefix}${executable_path}git[[:space:]]+(${git_global_option}[[:space:]]+)*(commit|tag|push)([[:space:]]|$)"
  local bare_gh_release="${command_wrapper_prefix}(${assignment_token}[[:space:]]+)*${env_prefix}${executable_path}gh[[:space:]]+(${gh_selector_flag}[[:space:]]+)*release[[:space:]]+(${gh_selector_flag}[[:space:]]+)*${gh_action}([[:space:]]|$)"
  local bare_release_script="${release_exec_prefix}${release_script_name}([[:space:];|&()]|$)"
  local bare_protected="(${bare_git_protected}|${bare_gh_release}|${bare_release_script})"
  local protected_after_separator="[;|&][;|&]?[[:space:]]*${bare_protected}"
  local cd_only_protected="^[[:space:]]*(cd[[:space:]]+[^;|&]+[[:space:]]*([;]|&&)[[:space:]]*)+${bare_protected}"
  local nested_shell_protected="${command_start}${command_wrapper_prefix}${executable_path}(bash|sh)[[:space:]]+[^;|&]*(-[A-Za-z]*c[A-Za-z]*|--command)[[:space:]]+[^;|&]*((${executable_path}git[[:space:]]+[^;|&]*(commit|tag|push))|(${executable_path}gh[[:space:]]+[^;|&]*release[[:space:]]+${gh_action})|((scripts|tools|bin)/([.]/)*${release_script_name}))"
  local env_chdir_protected="${command_start}${command_wrapper_prefix}env[[:space:]]+[^;|&]*(-C[[:space:]]+|--chdir([=[:space:]]+))[^;|&]*((${executable_path}git[[:space:]]+[^;|&]*(commit|tag|push))|(${executable_path}gh[[:space:]]+[^;|&]*release[[:space:]]+${gh_action})|((scripts|tools|bin)/([.]/)*${release_script_name}))"
  local gh_inherited_selector=false
  if [ -n "${GH_REPO:-}" ] || [ -n "${GH_HOST:-}" ]; then
    gh_inherited_selector=true
  fi
  local git_inherited_selector=false
  if [ -n "${GIT_ALTERNATE_OBJECT_DIRECTORIES:-}" ] \
    || [ -n "${GIT_COMMON_DIR:-}" ] \
    || [ -n "${GIT_CONFIG_COUNT:-}" ] \
    || [ -n "${GIT_CONFIG_PARAMETERS:-}" ] \
    || [ -n "${GIT_DIR:-}" ] \
    || [ -n "${GIT_INDEX_FILE:-}" ] \
    || [ -n "${GIT_NAMESPACE:-}" ] \
    || [ -n "${GIT_OBJECT_DIRECTORY:-}" ] \
    || [ -n "${GIT_WORK_TREE:-}" ]; then
    git_inherited_selector=true
  fi

  if command -v python3 >/dev/null 2>&1; then
    COMMAND_TEXT="$command_text" python3 - <<'PY'
import os
import os.path
import re
import shlex

command = os.environ["COMMAND_TEXT"]

def strip_shell_comments_preserving_newlines(value):
    output = []
    quote = None
    escaped = False
    in_comment = False
    word_start = True
    command_boundaries = ";|&(){}<>\n"

    for character in value:
        if in_comment:
            if character == "\n":
                output.append(character)
                in_comment = False
                word_start = True
            continue
        if escaped:
            output.append(character)
            escaped = False
            word_start = False
            continue
        if quote == "'":
            output.append(character)
            if character == quote:
                quote = None
            continue
        if quote == '"':
            output.append(character)
            if character == "\\":
                escaped = True
            elif character == quote:
                quote = None
            continue
        if character == "\\":
            output.append(character)
            escaped = True
            continue
        if character in {"'", '"'}:
            output.append(character)
            quote = character
            word_start = False
            continue
        if character == "#" and word_start:
            in_comment = True
            continue
        output.append(character)
        word_start = character.isspace() or character in command_boundaries

    return "".join(output)

try:
    # Newlines are shell command separators, not ordinary whitespace. Keep
    # them as tokens so a read-only command cannot hide a protected command on
    # the following line. Quoted newlines remain part of the quoted token.
    lexer = shlex.shlex(
        strip_shell_comments_preserving_newlines(command),
        posix=True,
        punctuation_chars="();<>|&\n",
    )
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    lexer.commenters = ""
    tokens = list(lexer)
except ValueError:
    tokens = command.split()

if not tokens:
    raise SystemExit

def emit(event, cwd="."):
    print(f"{event}\t{cwd}")
    raise SystemExit

def is_version_tag(value):
    return bool(re.match(r"^v?\d+(?:\.\d+){1,3}(?:[-+][A-Za-z0-9_.-]+)?$", value))

env_assignment = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=")
mutating_gh_release_actions = {"create", "edit", "upload", "delete", "delete-asset"}
shell_separators = {";", "&&", "||", "|", "|&", "&", "(", ")", "\n"}
gh_selector_names = {"GH_REPO", "GH_HOST"}
git_selector_names = {
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_COMMON_DIR",
    "GIT_CONFIG_COUNT",
    "GIT_CONFIG_PARAMETERS",
    "GIT_DIR",
    "GIT_INDEX_FILE",
    "GIT_NAMESPACE",
    "GIT_OBJECT_DIRECTORY",
    "GIT_WORK_TREE",
}
selector_names = gh_selector_names | git_selector_names
leading_shell_words = {"!", "{", "}", "if", "then", "elif", "else", "while", "until", "do"}

def is_git_selector_name(name):
    return name in git_selector_names or name.startswith("GIT_CONFIG_KEY_") or name.startswith("GIT_CONFIG_VALUE_")

def command_name(token):
    return os.path.basename(token) if "/" in token else token

def resolve_cwd(current, target):
    expanded = os.path.expanduser(target)
    return expanded if os.path.isabs(expanded) else os.path.normpath(os.path.join(current, expanded))

def command_args(start):
    args = []
    for token in tokens[start:]:
        if token in shell_separators:
            break
        args.append(token)
    return args

def git_invocation(index, default_cwd="."):
    cursor = index + 1
    cwd = default_cwd
    unsafe_selector = False
    while cursor < len(tokens):
        current = tokens[cursor]
        if current in shell_separators:
            return None, [], cwd, unsafe_selector
        if current == "-C" and cursor + 1 < len(tokens):
            target = tokens[cursor + 1]
            cwd = target if os.path.isabs(target) else os.path.normpath(os.path.join(cwd, target))
            cursor += 2
            continue
        if current.startswith("-C") and len(current) > 2:
            target = current[2:]
            cwd = target if os.path.isabs(target) else os.path.normpath(os.path.join(cwd, target))
            cursor += 1
            continue
        if current in {
            "-c",
            "--config-env",
            "--exec-path",
            "--git-dir",
            "--namespace",
            "--work-tree",
        } and cursor + 1 < len(tokens):
            unsafe_selector = True
            cursor += 2
            continue
        if current == "--bare" or (current.startswith("-c") and len(current) > 2):
            unsafe_selector = True
            cursor += 1
            continue
        if current.startswith(
            ("--config-env=", "--exec-path=", "--git-dir=", "--namespace=", "--work-tree=")
        ):
            unsafe_selector = True
            cursor += 1
            continue
        if current.startswith("-"):
            cursor += 1
            continue
        return current, command_args(cursor + 1), cwd, unsafe_selector
    return None, [], cwd, unsafe_selector

def assignment_parts(token):
    match = env_assignment.match(token)
    if match:
        return match.group(1), token[match.end():]
    return None, None

def command_segment_start(index):
    start = index
    while start > 0 and tokens[start - 1] not in shell_separators:
        start -= 1
    return start

def update_selector(active_selectors, token):
    name, value = assignment_parts(token)
    if name not in selector_names and not (name and is_git_selector_name(name)):
        return
    if value:
        active_selectors.add(name)
    else:
        active_selectors.discard(name)

def command_prefix_state(index, default_cwd="."):
    start = command_segment_start(index)
    cursor = start
    active_selectors = {
        name
        for name, value in os.environ.items()
        if value and (name in selector_names or is_git_selector_name(name))
    }
    effective_cwd = default_cwd

    while cursor < index and tokens[cursor] in leading_shell_words:
        cursor += 1

    while cursor < index and env_assignment.match(tokens[cursor]):
        update_selector(active_selectors, tokens[cursor])
        cursor += 1

    while cursor < index:
        wrapper = command_name(tokens[cursor])
        if wrapper in leading_shell_words:
            cursor += 1
            continue
        if wrapper == "command":
            cursor += 1
            while cursor < index and tokens[cursor] in {"-p", "-v", "-V", "--"}:
                cursor += 1
            continue
        if wrapper == "env":
            cursor += 1
            parse_options = True
            while cursor < index:
                arg = tokens[cursor]
                if parse_options and arg == "--":
                    parse_options = False
                    cursor += 1
                    continue
                if parse_options and arg in {"-i", "--ignore-environment"}:
                    active_selectors.clear()
                    cursor += 1
                    continue
                if parse_options and arg in {"-u", "--unset"} and cursor + 1 < index:
                    active_selectors.discard(tokens[cursor + 1])
                    cursor += 2
                    continue
                if parse_options and (arg.startswith("--unset=") or (arg.startswith("-u") and len(arg) > 2)):
                    active_selectors.discard(arg.split("=", 1)[1] if "=" in arg else arg[2:])
                    cursor += 1
                    continue
                if parse_options and arg in {"-C", "--chdir"} and cursor + 1 < index:
                    effective_cwd = resolve_cwd(effective_cwd, tokens[cursor + 1])
                    cursor += 2
                    continue
                if parse_options and arg.startswith("--chdir="):
                    effective_cwd = resolve_cwd(effective_cwd, arg.split("=", 1)[1])
                    cursor += 1
                    continue
                if parse_options and arg in {"-S", "--split-string"} and cursor + 1 < index:
                    cursor += 2
                    continue
                if parse_options and arg.startswith("--split-string="):
                    cursor += 1
                    continue
                if parse_options and arg.startswith("-"):
                    cursor += 1
                    continue
                if env_assignment.match(arg):
                    update_selector(active_selectors, arg)
                    cursor += 1
                    continue
                break
            continue
        if wrapper == "exec":
            cursor += 1
            while cursor < index:
                arg = tokens[cursor]
                if arg in {"-a"} and cursor + 1 < index:
                    cursor += 2
                    continue
                if arg in {"-c", "-l", "--"}:
                    cursor += 1
                    continue
                break
            continue
        if wrapper == "nohup":
            cursor += 1
            if cursor < index and tokens[cursor] == "--":
                cursor += 1
            continue
        if wrapper == "nice":
            cursor += 1
            while cursor < index:
                arg = tokens[cursor]
                if arg in {"-n", "--adjustment"} and cursor + 1 < index:
                    cursor += 2
                    continue
                if arg.startswith("--adjustment=") or re.match(r"^-[0-9]+$", arg):
                    cursor += 1
                    continue
                if arg == "--":
                    cursor += 1
                    continue
                break
            continue
        if wrapper == "time":
            cursor += 1
            while cursor < index:
                arg = tokens[cursor]
                if arg in {"-f", "--format", "-o", "--output"} and cursor + 1 < index:
                    cursor += 2
                    continue
                if arg.startswith("--format=") or arg.startswith("--output="):
                    cursor += 1
                    continue
                if arg in {"-a", "--append", "-p", "--portability", "-v", "--verbose", "--quiet", "-q", "--"}:
                    cursor += 1
                    continue
                break
            continue
        break
    return cursor == index, active_selectors, effective_cwd

def is_command_token(index, default_cwd="."):
    is_command, _selectors, _effective_cwd = command_prefix_state(index, default_cwd)
    return is_command

def gh_command_has_selector(index, default_cwd="."):
    _is_command, active_selectors, _effective_cwd = command_prefix_state(index, default_cwd)
    return bool(active_selectors & gh_selector_names)

def gh_release_event(index, default_cwd="."):
    cursor = index + 1
    has_repo_flag = gh_command_has_selector(index, default_cwd)
    # Step 1: skip leading global flags to find the gh subcommand.
    while cursor < len(tokens):
        arg = tokens[cursor]
        if arg in shell_separators:
            return None
        if arg in {"--repo", "-R"} and cursor + 1 < len(tokens):
            has_repo_flag = True
            cursor += 2
            continue
        if arg.startswith("--repo=") or arg.startswith("-R="):
            has_repo_flag = True
            cursor += 1
            continue
        if arg.startswith("-R") and len(arg) > 2:
            has_repo_flag = True
            cursor += 1
            continue
        if arg == "--hostname" and cursor + 1 < len(tokens):
            has_repo_flag = True
            cursor += 2
            continue
        if arg.startswith("--hostname="):
            has_repo_flag = True
            cursor += 1
            continue
        if arg.startswith("-"):
            cursor += 1
            continue
        break
    # Step 2: subcommand must be exactly "release"; the first positional
    # after release-subcommand args is the action. Track repo and host
    # selectors in any inherited position.
    if cursor >= len(tokens) or tokens[cursor] != "release":
        return None
    sub_idx = cursor + 1
    action = None
    while sub_idx < len(tokens):
        arg = tokens[sub_idx]
        if arg in shell_separators:
            break
        if arg in {"--repo", "-R"} and sub_idx + 1 < len(tokens):
            has_repo_flag = True
            sub_idx += 2
            continue
        if arg.startswith("--repo=") or arg.startswith("-R="):
            has_repo_flag = True
            sub_idx += 1
            continue
        if arg.startswith("-R") and len(arg) > 2:
            has_repo_flag = True
            sub_idx += 1
            continue
        if arg == "--hostname" and sub_idx + 1 < len(tokens):
            has_repo_flag = True
            sub_idx += 2
            continue
        if arg.startswith("--hostname="):
            has_repo_flag = True
            sub_idx += 1
            continue
        if arg.startswith("-"):
            sub_idx += 1
            continue
        if action is None:
            action = arg
        sub_idx += 1
    if action not in mutating_gh_release_actions:
        return None
    if has_repo_flag:
        return "release_remote"
    return "release"

def git_tag_is_mutation(args):
    if not args:
        return False
    mutating_long = {
        "--annotate",
        "--cleanup",
        "--delete",
        "--edit",
        "--file",
        "--force",
        "--local-user",
        "--message",
        "--sign",
    }
    mutating_short = set("asufdmF")
    inspection_long = {
        "--contains",
        "--format",
        "--ignore-case",
        "--list",
        "--merged",
        "--no-contains",
        "--no-merged",
        "--points-at",
        "--sort",
        "--verify",
    }
    inspection_short = set("lvn")
    inspection_mode = False
    literal_args = False

    for arg in args:
        if not literal_args and arg == "--":
            literal_args = True
            continue

        if not literal_args and arg.startswith("--"):
            option_name = arg.split("=", 1)[0]
            if option_name in mutating_long:
                return True
            if option_name in inspection_long:
                inspection_mode = True
            continue

        if not literal_args and arg.startswith("-"):
            flags = arg[1:]
            if any(flag in mutating_short for flag in flags):
                return True
            if any(flag in inspection_short for flag in flags):
                inspection_mode = True
            continue

        if not inspection_mode:
            return True

    return False

def git_commit_has_implicit_staging(args):
    implicit_long = {
        "--all",
        "--include",
        "--interactive",
        "--only",
        "--patch",
        "--pathspec-file-nul",
        "--pathspec-from-file",
    }
    long_value_options = {
        "--author",
        "--cleanup",
        "--date",
        "--file",
        "--fixup",
        "--gpg-sign",
        "--message",
        "--reedit-message",
        "--reuse-message",
        "--squash",
        "--template",
        "--trailer",
    }
    short_value_options = {"C", "F", "c", "m", "t"}
    implicit_short = {"a", "i", "o", "p"}
    cursor = 0
    literal_args = False
    while cursor < len(args):
        arg = args[cursor]
        if literal_args:
            return True
        if arg == "--":
            literal_args = True
            cursor += 1
            continue
        if arg.startswith("--"):
            option = arg.split("=", 1)[0]
            if option in implicit_long:
                return True
            if option in long_value_options and "=" not in arg:
                cursor += 2
            else:
                cursor += 1
            continue
        if arg.startswith("-") and arg != "-":
            cluster = arg[1:]
            while cluster:
                flag = cluster[0]
                cluster = cluster[1:]
                if flag in implicit_short:
                    return True
                if flag in short_value_options:
                    if not cluster:
                        cursor += 1
                    cluster = ""
            cursor += 1
            continue
        return True
    return False

def git_push_is_release(args):
    if any(arg in {"--tags", "--follow-tags", "--mirror"} for arg in args):
        return True
    for index, arg in enumerate(args):
        normalized = arg.lstrip("+")
        if "refs/tags/" in normalized:
            return True
        if is_version_tag(normalized):
            return True
        if arg == "tag" and index + 1 < len(args):
            return True
    return False

def interpreter_script(executable, args):
    name = os.path.basename(executable)
    is_python = re.fullmatch(r"python(?:\d+(?:\.\d+)*)?", name) is not None
    if name not in {"bash", "sh", "node"} and not is_python:
        return executable, args

    cursor = 0
    while cursor < len(args):
        arg = args[cursor]
        if arg == "--":
            cursor += 1
            break
        if name in {"bash", "sh"} and arg in {"-c", "--command"}:
            return None, []
        if is_python and arg in {"-c", "-m"}:
            return None, []
        if name == "node" and arg in {"-e", "--eval", "-p", "--print"}:
            return None, []
        option_has_value = (
            (name in {"bash", "sh"} and arg in {"-O", "-o", "--rcfile", "--init-file"})
            or (is_python and arg in {"-W", "-X", "--check-hash-based-pycs"})
            or (name == "node" and arg in {"--require", "-r", "--import"})
        )
        if option_has_value and cursor + 1 < len(args):
            cursor += 2
            continue
        if arg.startswith("-"):
            cursor += 1
            continue
        break
    if cursor >= len(args):
        return None, []
    return args[cursor], args[cursor + 1 :]

def repo_release_script_event(executable, args, shell_cwd):
    script, script_args = interpreter_script(executable, args)
    if not script:
        return None
    candidate = script if os.path.isabs(script) else os.path.join(shell_cwd, script)
    normalized = os.path.normpath(candidate)
    parent = os.path.basename(os.path.dirname(normalized))
    if parent not in {"scripts", "tools", "bin"}:
        return None
    name = os.path.basename(normalized)
    for suffix in (".sh", ".py", ".js", ".ts"):
        if name.endswith(suffix):
            name = name[: -len(suffix)]
            break
    mutating_names = {
        "bump-version",
        "version",
        "package",
        "release",
        "publish",
        "promote",
        "publish-release",
        "promote-artifact",
        "cut-release",
    }
    if name not in mutating_names:
        return None
    if name == "bump-version" and script_args in (["--check"], ["--audit"]):
        return None
    repo_hint = os.path.dirname(os.path.dirname(normalized))
    return repo_hint

def nested_shell_command(executable, args):
    if command_name(executable) not in {"bash", "sh"}:
        return None
    cursor = 0
    while cursor < len(args):
        arg = args[cursor]
        if arg in {"-c", "--command"} and cursor + 1 < len(args):
            return args[cursor + 1]
        if arg.startswith("-") and not arg.startswith("--") and "c" in arg[1:] and cursor + 1 < len(args):
            return args[cursor + 1]
        if arg == "--":
            return None
        if not arg.startswith("-"):
            return None
        cursor += 1
    return None

def nested_shell_has_protected_command(value):
    executable = r"(?:[^ \t\r\n;|&(){}]+/)*"
    boundary = r"(?:^|[;|&(){}\n][ \t]*)"
    wrappers = (
        r"(?:(?:(?:command|exec|nohup|time|env|if|then|elif|else|while|until|do)"
        r"(?:[ \t]+-[^ \t;|&(){}]+)*[ \t]+)|"
        r"(?:[A-Za-z_][A-Za-z0-9_]*=[^ \t;|&(){}]+[ \t]+))*"
    )
    protected = (
        rf"{boundary}{wrappers}{executable}git[ \t]+[^;|&\n]*\b(?:commit|tag|push)\b"
        rf"|{boundary}{wrappers}{executable}gh[ \t]+[^;|&\n]*\brelease\b[ \t]+(?:create|edit|upload|delete|delete-asset)\b"
        rf"|{boundary}{wrappers}{executable}(?:scripts|tools|bin)/(?:\./)*(?:bump-version|version|package|release|publish|promote|publish-release|promote-artifact|cut-release)(?:\.(?:sh|py|js|ts))?\b"
    )
    return re.search(protected, value) is not None

shell_cwd = os.getcwd()
protected_events = []
has_add = False
has_commit = False
has_implicit_commit = False
has_mutating_tag = False
has_push = False
prior_command = False
protected_has_prelude = False
prefix_executables = {
    "!",
    "{",
    "}",
    "command",
    "do",
    "elif",
    "else",
    "env",
    "exec",
    "if",
    "nice",
    "nohup",
    "then",
    "time",
    "until",
    "while",
}

# Subshell-scoped `cd` is intentionally treated as outer-scope: over-blocking
# is the safe direction when shell scope is ambiguous from tokens alone.
for index, token in enumerate(tokens):
    if token in shell_separators:
        continue
    is_command, active_selectors, effective_cwd = command_prefix_state(index, shell_cwd)
    if not is_command:
        continue

    args = command_args(index + 1)
    executable = command_name(token)
    if executable == "cd":
        cd_args = [arg for arg in args if arg != "--"]
        if cd_args:
            shell_cwd = resolve_cwd(effective_cwd, cd_args[0])
        continue

    if executable == "git":
        subcommand, rest, cwd, unsafe_global_selector = git_invocation(index, effective_cwd)
        if subcommand is None:
            continue
        unsafe_selector = unsafe_global_selector or any(
            is_git_selector_name(name) for name in active_selectors
        )
        if subcommand == "add":
            has_add = True
            prior_command = True
        elif subcommand == "commit":
            has_commit = True
            has_implicit_commit = has_implicit_commit or git_commit_has_implicit_staging(rest)
            protected_has_prelude = protected_has_prelude or prior_command
            protected_events.append(("protected_git_selector" if unsafe_selector else "commit", cwd))
        elif subcommand == "tag" and git_tag_is_mutation(rest):
            has_mutating_tag = True
            protected_has_prelude = protected_has_prelude or prior_command
            protected_events.append(("protected_git_selector" if unsafe_selector else "release", cwd))
        elif subcommand == "push":
            has_push = True
            if git_push_is_release(rest):
                protected_has_prelude = protected_has_prelude or prior_command
                protected_events.append(("protected_git_selector" if unsafe_selector else "release", cwd))
            else:
                prior_command = True
        else:
            prior_command = True
        continue

    if executable == "gh":
        event = gh_release_event(index, shell_cwd)
        if event:
            protected_has_prelude = protected_has_prelude or prior_command
            protected_events.append((event, effective_cwd))
        else:
            prior_command = True
        continue

    nested_command = nested_shell_command(token, args)
    if nested_command is not None and nested_shell_has_protected_command(nested_command):
        emit("protected_nested_shell", effective_cwd)

    repo_hint = repo_release_script_event(token, args, effective_cwd)
    if repo_hint is not None:
        protected_has_prelude = protected_has_prelude or prior_command
        protected_events.append(("release", repo_hint))
        continue

    if (
        executable not in prefix_executables
        and env_assignment.match(token) is None
        and command_segment_start(index) == index
    ):
        prior_command = True

# Receipt checks bind one reviewed operation. Reject protected compositions
# before selecting an individual event so the first receipt can never authorize
# a later protected phase in the same shell command.
if any(event == "protected_git_selector" for event, _cwd in protected_events):
    emit("protected_git_selector")
if has_commit and has_push:
    emit("combined_commit_push")
if has_mutating_tag and has_push:
    emit("combined_tag_push")
if has_add and has_commit:
    emit("combined_stage_commit", next(cwd for event, cwd in protected_events if event == "commit"))
if has_implicit_commit:
    emit("commit_implicit_stage", next(cwd for event, cwd in protected_events if event == "commit"))
if any(event == "release_remote" for event, _cwd in protected_events):
    emit("release_remote")
if len(protected_events) > 1:
    emit("combined_protected")
if protected_has_prelude:
    emit("protected_with_prelude")
if protected_events:
    emit(*protected_events[0])
PY
    return
  fi

  if { [ "$git_inherited_selector" = true ] \
      || printf '%s\n' "$command_text" | grep -Eq "${git_unsafe_global_selector}|${git_unsafe_env_selector}"; } \
    && printf '%s\n' "$command_text" | grep -Eq "${git_commit_command}|${git_tag_command}|${git_push_tag_command}"; then
    printf 'protected_git_selector\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$nested_shell_protected"; then
    printf 'protected_nested_shell\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$env_chdir_protected"; then
    printf 'protected_unresolved_repo\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$gh_mutating_release" \
    && { [ "$gh_inherited_selector" = true ] \
      || printf '%s\n' "$command_text" | grep -Eq "${gh_env_selector}|${gh_remote_mutating_release}"; }; then
    printf 'release_remote\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$git_redirected_protected"; then
    printf 'protected_unresolved_repo\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$git_commit_command" \
    && printf '%s\n' "$command_text" | grep -Eq "$git_push_command"; then
    printf 'combined_commit_push\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$git_tag_command" \
    && printf '%s\n' "$command_text" | grep -Eq "$git_push_command"; then
    printf 'combined_tag_push\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$git_commit_command" \
    && printf '%s\n' "$command_text" | grep -Eq "$release_command_pattern"; then
    printf 'combined_protected\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$git_add_command.*$git_commit_command"; then
    printf 'combined_stage_commit\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "${git_commit_implicit}|${git_commit_pathspec}"; then
    printf 'commit_implicit_stage\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$protected_after_separator" \
    && ! printf '%s\n' "$command_text" | grep -Eq "$cd_only_protected"; then
    printf 'protected_with_prelude\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$git_commit_command"; then
    printf 'commit\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$git_tag_command|$git_push_tag_command"; then
    printf 'release\t.\n'
  elif printf '%s\n' "$command_text" | grep -Eq "$repo_release_script" \
    && ! printf '%s\n' "$command_text" | grep -Eq "$repo_release_read_only"; then
    printf 'release\t.\n'
  # gh release detection (degraded path, python3 unavailable): require release
  # to be the gh subcommand, optionally preceded by recognized global flags so
  # commands like `gh issue create --title release` are not classified as
  # releases.
  elif printf '%s\n' "$command_text" | grep -Eq "$gh_mutating_release"; then
    printf 'release\t.\n'
  fi
}

protected_command_summary() {
  cat <<'EOF'
Staff Engineer Mode PreToolUse protected commands:
- commit: git commit
- release: git tag mutation
- release: git push tags
- release: gh release create|edit|upload|delete|delete-asset ... for the current checkout
- release_remote: gh release create|edit|upload|delete|delete-asset ... with --repo, -R, --hostname, GH_REPO, or GH_HOST
- release: repo-local scripts/{bump-version,version,package,release,publish,promote} commands and the supported compound variants; only bump-version --check and --audit remain read-only
- invalid composition: multiple protected operations, implicit commit staging/pathspecs, git commit plus git push, or a mutating git tag plus git push, in one shell command
- invalid prelude: a protected operation after another command that may change receipt-bound state; a literal cd to the target checkout is allowed
- invalid indirection: protected operations hidden inside nested shell command strings, where the hook cannot bind a receipt to the exact operation state
- invalid Git state selector: protected Git operations that override the checkout, worktree, namespace, index, object storage, or configuration used by the receipt
EOF
}

repo_root() {
  local repo_hint="$1"
  if git -C "$repo_hint" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$repo_hint" rev-parse --show-toplevel
  else
    return 1
  fi
}

git_dir() {
  local repo="$1"
  local dir
  dir="$(git -C "$repo" rev-parse --git-dir)"
  case "$dir" in
    /*) printf '%s\n' "$dir" ;;
    *) printf '%s/%s\n' "$repo" "$dir" ;;
  esac
}

commit_key() {
  local repo="$1"
  {
    printf 'head\0'
    git -C "$repo" rev-parse HEAD 2>/dev/null || printf 'no-head\n'
    printf '\0staged\0'
    git -C "$repo" diff --cached --binary
  } | hash_stdin
}

release_key() {
  local repo="$1"
  {
    printf 'head\0'
    git -C "$repo" rev-parse HEAD 2>/dev/null || printf 'no-head\n'
    printf '\0staged\0'
    git -C "$repo" diff --cached --binary
    printf '\0unstaged\0'
    git -C "$repo" diff --binary
    printf '\0untracked\0'
    while IFS= read -r -d '' path; do
      printf '%s\0' "$path"
      if [ -x "$repo/$path" ]; then
        printf 'executable\0'
      else
        printf 'non-executable\0'
      fi
      git -C "$repo" hash-object -- "$path" 2>/dev/null || printf 'unreadable\n'
    done < <(git -C "$repo" ls-files --others --exclude-standard -z)
  } | hash_stdin
}

receipt_path() {
  local repo="$1"
  local event="$2"
  local key="$3"
  printf '%s/%s/%s/%s.json\n' "$(git_dir "$repo")" "$RECEIPT_DIR" "$event" "$key"
}

write_receipt() {
  local event="$1"
  local repo="$2"
  local key="$3"
  local override="${4:-false}"
  local rationale="${5:-}"
  local receipt
  receipt="$(receipt_path "$repo" "$event" "$key")"
  mkdir -p "$(dirname "$receipt")"
  printf '{\n  "event": "%s",\n  "key": "%s",\n  "head": "%s",\n  "created_at": "%s",\n  "override": %s,\n  "rationale": %s\n}\n' \
    "$event" \
    "$key" \
    "$(git -C "$repo" rev-parse HEAD 2>/dev/null || printf 'no-head')" \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    "$override" \
    "$(json_escape "$rationale")" > "$receipt"
  printf 'recorded staff-engineer-mode %s receipt for %s\n' "$event" "$key"
}

has_receipt() {
  local repo="$1"
  local event="$2"
  local key="$3"
  test -f "$(receipt_path "$repo" "$event" "$key")"
}

ack_event() {
  local event="${1:-}"
  shift || true
  local override="false"
  local rationale=""
  local repo_hint="."
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo)
        shift
        repo_hint="${1:-}"
        if [ -z "$repo_hint" ]; then
          printf 'usage: %s ack commit|release [--repo path] [--override rationale]\n' "$0" >&2
          exit 1
        fi
        shift
        ;;
      --repo=*)
        repo_hint="${1#--repo=}"
        shift
        ;;
      --override)
        override="true"
        shift
        rationale="${*:-user accepted unresolved review findings}"
        break
        ;;
      --override=*)
        override="true"
        rationale="${1#--override=}"
        shift
        ;;
      *)
        printf 'usage: %s ack commit|release [--repo path] [--override rationale]\n' "$0" >&2
        exit 1
        ;;
    esac
  done

  local repo
  repo="$(repo_root "$repo_hint")" || {
    printf 'staff-engineer-mode: --repo must be a local checkout root from git rev-parse --show-toplevel, not a remote URL or bare repository\n' >&2
    exit 1
  }

  case "$event" in
    commit)
      write_receipt "commit" "$repo" "$(commit_key "$repo")" "$override" "$rationale"
      ;;
    release)
      write_receipt "release" "$repo" "$(release_key "$repo")" "$override" "$rationale"
      ;;
    *)
      printf 'usage: %s ack commit|release [--repo path] [--override rationale]\n' "$0" >&2
      exit 1
      ;;
  esac
}

pretooluse() {
  local hook_input command_text classification event repo_hint repo
  hook_input="$(cat || true)"
  command_text="$(extract_command "$hook_input")"
  [ -n "$command_text" ] || exit 0

  classification="$(classify_command "$command_text")"
  [ -n "$classification" ] || exit 0

  event="${classification%%	*}"
  repo_hint="${classification#*	}"
  [ "$repo_hint" != "$classification" ] || repo_hint="."

  # Cross-repo gh releases are blocked regardless of local checkout state;
  # handle before requiring a local repo so non-repo directories cannot bypass.
  if [ "$event" = "release_remote" ]; then
    block_tool "Staff Engineer Mode before_release policy: gh --repo / -R / --hostname / GH_REPO / GH_HOST targets a remote repository or host, not just the local checkout. A local release receipt cannot authorize a cross-repo release. To proceed, remove the remote repo or host selector and run gh release from the target repository's checkout (so the local release-build-reproducibility and production-readiness-review checks plus release receipt apply), or temporarily disable this hook with explicit user authorization."
  fi

  if [ "$event" = "protected_git_selector" ]; then
    block_tool "Staff Engineer Mode event policy cannot bind a commit or release receipt when Git repository, worktree, namespace, index, object storage, or configuration selectors override the checkout state. Remove alternate Git flags and GIT_* selector variables, enter the intended checkout normally, refresh the matching review and receipt there, and run the protected Git command directly."
  fi

  if [ "$event" = "combined_commit_push" ]; then
    block_tool "Staff Engineer Mode before_commit policy requires commit and push commands to run as separate shell commands. A commit review receipt authorizes only the commit operation; it never authorizes a push composed into the same command. Run the reviewed commit first, inspect its result, then run push separately if the user has requested it."
  fi

  if [ "$event" = "combined_tag_push" ]; then
    block_tool "Staff Engineer Mode before_release policy requires tag and push commands to run as separate shell commands. A release review receipt authorizes only one release phase at a time; it never authorizes creating and pushing a tag in the same command. Create the reviewed tag first, inspect its result, then push the tag separately."
  fi

  if [ "$event" = "combined_protected" ]; then
    block_tool "Staff Engineer Mode event policy blocks multiple protected operations in one shell command. Review and run commit, tag, package, promotion, and release operations as separate shell commands so each operation is checked against the exact local state it will consume."
  fi

  if [ "$event" = "protected_with_prelude" ]; then
    block_tool "Staff Engineer Mode event policy cannot authorize a protected operation after a preceding command in the same shell invocation because that command may change the state bound to the receipt. Each operation must run in its own shell command: inspect the first result, refresh the matching review and receipt if state changed, then run the commit, tag, package, promotion, or release operation directly. Do not combine the ack command with the commit command. Do not combine the ack command with the release command. Run the operations as separate shell commands. A literal cd to the target checkout may remain in the protected invocation."
  fi

  if [ "$event" = "protected_unresolved_repo" ]; then
    block_tool "Staff Engineer Mode event policy cannot safely resolve a protected command's target repository without Python shell parsing. Run cd to the intended checkout as a separate shell command, then retry the commit, tag, or push without git -C so the receipt is checked against the correct repository."
  fi

  if [ "$event" = "protected_nested_shell" ]; then
    block_tool "Staff Engineer Mode event policy cannot safely bind a receipt to a protected operation hidden inside a nested shell command. Run the commit, tag, push, package, promotion, or release command directly in its own shell invocation so the hook can resolve the target checkout and exact state."
  fi

  if repo="$(repo_root "$repo_hint")"; then
    :
  else
    local physical_pwd
    physical_pwd="$(pwd -P 2>/dev/null || printf '%s\n' "$PWD")"
    if [ "$repo_hint" != "." ] && [ "$repo_hint" != "$PWD" ] && [ "$repo_hint" != "$physical_pwd" ]; then
      block_tool "Staff Engineer Mode event policy cannot safely resolve the protected command's target repository (${repo_hint}). Use a literal checkout path, run cd as a separate shell command when the path depends on shell expansion, and retry so the receipt is checked against the repository the command will actually modify."
    fi
    repo="$(repo_root ".")" || exit 0
  fi
  local quoted_repo
  quoted_repo="$(shell_quote "$repo")"
  local has_ai_attribution=false
  local attribution_instruction=""
  if command_has_ai_commit_attribution "$command_text"; then
    has_ai_attribution=true
    attribution_instruction=" Remove any AI assistant Co-Authored-By or attribution trailer before retrying the commit command."
  fi

  case "$event" in
    commit|combined_stage_commit|commit_implicit_stage)
      if [ "$has_ai_attribution" = true ]; then
        block_tool "Staff Engineer Mode before_commit policy blocks AI assistant co-author or attribution trailers in commit messages. Remove the AI co-author or attribution, then retry through the normal user-visible agent-pr-review and ack commit flow for ${repo}."
      fi
      if [ "$event" = "commit_implicit_stage" ]; then
        block_tool "Staff Engineer Mode before_commit policy requires agent-pr-review and cannot authorize implicit staging or commit pathspecs from a staged-diff receipt. You must stage intended changes separately, review the exact staged diff for ${repo}, record a matching commit receipt, and then run a plain git commit command without --all, --include, --only, --interactive, --patch, or path arguments."
      fi
      if [ "$event" = "combined_stage_commit" ] || command_stages_before_commit "$command_text"; then
        block_tool "Staff Engineer Mode before_commit policy requires agent-pr-review before running git commit. Stage intended files explicitly in a separate shell command, read ${PLUGIN_ROOT}/specialists/agent-pr-review.md, and review the exact staged diff for ${repo}; inspecting git diff --cached or reading CLAUDE.md / SKILL.md alone is not enough. Show the structured review artifact to the user before any receipt. If the review is clean, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} as its own shell command. Do not combine staging, ack, or git commit in one shell command; the PreToolUse hook checks the whole shell command before any subcommand can run. If the user explicitly accepts unresolved gaps after they are shown, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} --override \"<rationale>\" as its own shell command. Then retry git commit in a separate shell command."
      fi
      local key
      key="$(commit_key "$repo")"
      if ! has_receipt "$repo" "commit" "$key"; then
        block_tool "Staff Engineer Mode before_commit policy requires agent-pr-review before running git commit. Stage intended files explicitly, read ${PLUGIN_ROOT}/specialists/agent-pr-review.md, and review the exact staged diff for ${repo}; inspecting git diff --cached or reading CLAUDE.md / SKILL.md alone is not enough. Show the structured review artifact to the user before any receipt. If the review is clean, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} as its own shell command. Do not combine the ack command with the commit command; the PreToolUse hook checks the whole shell command before either subcommand can run. If the user explicitly accepts unresolved gaps after they are shown, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack commit --repo ${quoted_repo} --override \"<rationale>\" as its own shell command. Then retry git commit in a separate shell command."
      fi
      ;;
    release)
      local key
      key="$(release_key "$repo")"
      if ! has_receipt "$repo" "release" "$key"; then
        block_tool "Staff Engineer Mode before_release policy requires release-build-reproducibility and production-readiness-review before release, tag, version, package, artifact, or promotion commands. Read ${PLUGIN_ROOT}/specialists/release-build-reproducibility.md and check pinned inputs, artifact identity, promotion, and rollback traceability for ${repo}. Read ${PLUGIN_ROOT}/specialists/production-readiness-review.md and check release ownership, rollback, watch, and operator impact for ${repo}; reading CLAUDE.md / SKILL.md alone is not enough. Show both structured review artifacts to the user before any receipt. If both reviews are clean, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack release --repo ${quoted_repo} as its own shell command. Do not combine the ack command with the release command; the PreToolUse hook checks the whole shell command before either subcommand can run. If the user explicitly accepts unresolved gaps after they are shown, run \"${PLUGIN_ROOT}/hooks/agent-event-policy\" ack release --repo ${quoted_repo} --override \"<rationale>\" as its own shell command. Then retry the release command in a separate shell command. For tags, create the tag and push the tag in separate shell commands."
      fi
      ;;
  esac
}

case "${1:-pretooluse}" in
  list-protected)
    protected_command_summary
    ;;
  pretooluse)
    set +e +u +o pipefail
    pretooluse 2>/dev/null || true
    exit 0
    ;;
  ack)
    shift
    ack_event "$@"
    ;;
  *)
    printf 'usage: %s pretooluse|list-protected|ack commit|ack release\n' "$0" >&2
    exit 1
    ;;
esac
