#!/usr/bin/env bash
# SessionStart hook for staff-engineer-mode plugin integrations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ROUTER_PATH="${PLUGIN_ROOT}/skills/staff-engineer-mode/SKILL.md"
BOOTSTRAP_TEMPLATE_PATH="${PLUGIN_ROOT}/skills/staff-engineer-mode/references/bootstrap-context.md"
EVENT_HOOK_PATH="${PLUGIN_ROOT}/hooks/agent-event-policy"

if [ -r "$ROUTER_PATH" ]; then
  router_raw="$(cat "$ROUTER_PATH")"
else
  router_raw="Error reading staff-engineer-mode skill from ${ROUTER_PATH}"
fi

strip_frontmatter() {
  awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { in_frontmatter = 0; next }
    !in_frontmatter { print }
  '
}

if [ ! -r "$BOOTSTRAP_TEMPLATE_PATH" ]; then
  printf 'staff-engineer-mode: missing bootstrap template at %s\n' "$BOOTSTRAP_TEMPLATE_PATH" >&2
  exit 1
fi

bootstrap_template="$(cat "$BOOTSTRAP_TEMPLATE_PATH")"

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

router_content="$(printf '%s\n' "$router_raw" | strip_frontmatter)"
specialist_root="${PLUGIN_ROOT}/specialists"
current_repo="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
session_context="${bootstrap_template//\{\{SPECIALIST_ROOT\}\}/$specialist_root}"
session_context="${session_context//\{\{EVENT_HOOK\}\}/${EVENT_HOOK_PATH}}"
session_context="${session_context//\{\{CURRENT_REPO\}\}/${current_repo}}"
session_context="${session_context//\{\{ROUTER_CONTENT\}\}/${router_content}}"
session_context="${session_context//\{\{TOOL_MAPPING\}\}/}"
session_context="$(escape_for_json "$session_context")"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
