#!/usr/bin/env bash
# SessionStart hook for staff-engineer-mode plugin integrations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ROUTER_PATH="${PLUGIN_ROOT}/skills/routing/staff-engineer-mode/SKILL.md"

if [ -r "$ROUTER_PATH" ]; then
  router_content="$(cat "$ROUTER_PATH")"
else
  router_content="Error reading staff-engineer-mode skill from ${ROUTER_PATH}"
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

router_escaped="$(escape_for_json "$router_content")"
session_context="<EXTREMELY_IMPORTANT>\nYou have staff-engineer-mode.\n\nUsers are not expected to know or invoke individual Staff Engineer Mode skill names. For engineering lifecycle, DevOps, operations, reliability, resilience, security, architecture, data, platform, client, and cost-aware reliability requests, start by applying the staff-engineer-mode instructions below. After routing, use the native skill tool to load the selected specialist skill before giving detailed guidance.\n\nBelow is the full content of the router entrypoint skill:\n\n${router_escaped}\n</EXTREMELY_IMPORTANT>"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
